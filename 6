-- ==================== [4. VISUALS TAB (มองตัว)] ====================
local espBoxActive = false
local espNpcActive = false

addToggleWithDesc(tabVisuals, "มองตัว (Box ESP)", "เรืองแสงตัวละครผู้เล่นอื่นทะลุกำแพง", false, function(s)
    espBoxActive = s
end)

addToggleWithDesc(tabVisuals, "มองบอท (NPC Box ESP)", "แสดงเรืองแสงตัวบอท NPC ด้วย", false, function(s)
    espNpcActive = s
end)

local highlights = {}

local function getTargetModels()
    local targets = {}
    if espBoxActive then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                table.insert(targets, p.Character)
            end
        end
    end
    if espNpcActive then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                local isPlayerChar = false
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character == obj then
                        isPlayerChar = true
                        break
                    end
                end
                if not isPlayerChar and obj ~= LocalPlayer.Character then
                    table.insert(targets, obj)
                end
            end
        end
    end
    return targets
end

-- ลูปการทำงานหลัก
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if char then
        if isAirWalk and char:FindFirstChild("HumanoidRootPart") then
            airPlatform.CFrame = CFrame.new(char.HumanoidRootPart.Position.X, currentY, char.HumanoidRootPart.Position.Z)
        end

        if spinbotActive and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(spinSpeed), 0)
        end

        -- ระบบควบคุมความเร็วรถ
        local hrp = char.HumanoidRootPart
        local seatP = hrp and hrp.AssemblyRootPart
        if seatP and seatP:IsA("BasePart") and seatP.AssemblyLinearVelocity.Magnitude > 2 then
            local vehicle = seatP.Parent
            local vehicleDrive = vehicle:FindFirstChild("DriveSeat") or vehicle:FindFirstChildOfClass("VehicleSeat")
            if vehicleDrive and vehicleDrive:IsA("VehicleSeat") then
                if vehicleNormalSpeed then
                    vehicleDrive.MaxSpeed = normalSpeedVal
                elseif vehicleBoostActive then
                    if vehicleDrive.MaxSpeed < boostSpeedVal then
                        vehicleDrive.MaxSpeed = vehicleDrive.MaxSpeed + 5
                    end
                    vehicleDrive.Throttle = 1
                end
            end
        end
    end

    if hitboxActive then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local targetHrp = p.Character.HumanoidRootPart
                targetHrp.Size = Vector3.new(hbSize, hbSize, hbSize)
                targetHrp.Transparency = hbTrans
                targetHrp.BrickColor = BrickColor.new("Bright red")
                targetHrp.Material = Enum.Material.Neon
                targetHrp.CanCollide = false
            end
        end
    end

    -- ระบบ ESP มองตัว
    local currentTargets = getTargetModels()
    for target, hl in pairs(highlights) do
        local found = false
        for _, t in ipairs(currentTargets) do
            if t == target then
                found = true
                break
            end
        end
        if not found or not target or not target.Parent then
            hl:Destroy()
            highlights[target] = nil
        end
    end

    if espBoxActive or espNpcActive then
        for _, target in ipairs(currentTargets) do
            if not highlights[target] then
                local hl = Instance.new("Highlight")
                hl.FillColor = Color3.fromRGB(0, 230, 150)
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.FillTransparency = 0.5
                hl.Parent = target
                highlights[target] = hl
            end
        end
    end
end)

