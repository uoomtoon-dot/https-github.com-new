-- ฟังก์ชันสร้าง Tab
local tabs = {}
local tabButtons = {}

local function createTab(name, icon)
    local panel = Instance.new("ScrollingFrame", contentArea)
    panel.Size = UDim2.new(1, 0, 1, 0)
    panel.BackgroundTransparency = 1
    panel.ScrollBarThickness = 3
    panel.ScrollBarImageColor3 = Color3.fromRGB(60, 65, 75)
    panel.Visible = false

    local layout = Instance.new("UIListLayout", panel)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 8)

    local btn = Instance.new("TextButton", sidebar)
    btn.Size = UDim2.new(0.9, 0, 0, 32)
    btn.BackgroundColor3 = Color3.fromRGB(18, 20, 25)
    btn.BackgroundTransparency = 1
    btn.Text = "  " .. icon .. "  " .. name
    btn.TextColor3 = Color3.fromRGB(140, 145, 160)
    btn.TextSize = 11
    btn.Font = Enum.Font.GothamMedium
    btn.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    btn.MouseButton1Click:Connect(function()
        for _, tPanel in pairs(tabs) do tPanel.Visible = false end
        for _, bBtn in pairs(tabButtons) do
            bBtn.BackgroundTransparency = 1
            bBtn.TextColor3 = Color3.fromRGB(140, 145, 160)
        end
        panel.Visible = true
        btn.BackgroundTransparency = 0
        btn.BackgroundColor3 = Color3.fromRGB(28, 32, 40)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)

    tabs[name] = panel
    tabButtons[name] = btn
    return panel
end

